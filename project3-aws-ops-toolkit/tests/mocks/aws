#!/usr/bin/env bash
# Fake AWS CLI for offline tests. It answers from JSON fixtures and records every call.
#
#   MOCK_FIXTURES   folder with fixtures (required)
#   MOCK_STATE      folder for call log and captured requests (required)
#   MOCK_FAIL_DIGEST  ecr batch-delete-image reports this digest as a failure
#
# Calls are logged one per line to $MOCK_STATE/calls.log, so tests can check that
# secret values never appear on the command line.
set -euo pipefail

fix="${MOCK_FIXTURES:?MOCK_FIXTURES not set}"
state="${MOCK_STATE:?MOCK_STATE not set}"
printf '%s\n' "$*" >>"${state}/calls.log"

# Drop global options the wrapper adds.
args=()
while (($# > 0)); do
  case "$1" in
    --endpoint-url | --region | --output | --profile) shift 2 ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]}"
svc="$1" op="$2"
shift 2

# opt NAME args... -> value after NAME
opt() {
  local name="$1"; shift
  while (($# > 0)); do
    if [[ "$1" == "${name}" ]]; then printf '%s' "${2-}"; return 0; fi
    shift
  done
  return 1
}

# multi NAME args... -> every value after NAME until the next --option
multi() {
  local name="$1" on=false; shift
  for a in "$@"; do
    if [[ "${a}" == "${name}" ]]; then on=true; continue; fi
    [[ "${a}" == --* ]] && on=false
    [[ "${on}" == true ]] && printf '%s\n' "${a}"
  done
  return 0
}

case "${svc} ${op}" in
  "sts get-caller-identity")
    echo '{"UserId":"MOCK","Account":"123456789012","Arn":"arn:aws:iam::123456789012:user/mock"}' ;;

  "ecs list-services")
    cat "${fix}/ecs/list-services.json" ;;
  "ecs list-tasks")
    f="${fix}/ecs/list-tasks-$(opt --service-name "$@").json"
    if [[ -f "${f}" ]]; then cat "${f}"; else echo '{"taskArns":[]}'; fi ;;
  "ecs describe-tasks")
    multi --tasks "$@" | jq -R . | jq -s --slurpfile all "${fix}/ecs/describe-tasks.json" '
      . as $want | {tasks: [$all[0].tasks[] | select(.taskArn | IN($want[]))], failures: []}' ;;

  "ecr describe-images")
    f="${fix}/ecr/describe-images-$(opt --repository-name "$@").json"
    if [[ -f "${f}" ]]; then cat "${f}"; else
      echo "An error occurred (RepositoryNotFoundException) when calling the DescribeImages operation" >&2; exit 254
    fi ;;
  "ecr batch-get-image")
    d=$(multi --image-ids "$@" | sed -n 's/^imageDigest=//p' | head -n 1)
    jq --arg d "${d}" '{images: [.images[] | select(.imageId.imageDigest == $d)], failures: []}' \
      "${fix}/ecr/batch-get-image.json" ;;
  "ecr batch-delete-image")
    multi --image-ids "$@" | sed -n 's/^imageDigest=//p' >>"${state}/deleted.txt"
    multi --image-ids "$@" | sed -n 's/^imageDigest=//p' | jq -R . | jq -s --arg fail "${MOCK_FAIL_DIGEST:-}" '{
      imageIds: [.[] | select(. != $fail) | {imageDigest: .}],
      failures: [.[] | select(. == $fail) | {imageId: {imageDigest: .}, failureCode: "ImageNotFound", failureReason: "mock failure"}]}' ;;

  "ssm get-parameters-by-path")
    p=$(opt --path "$@")
    f="${fix}/ssm/${p//\//_}.json"
    if [[ -f "${f}" ]]; then cat "${f}"; else echo '{"Parameters":[]}'; fi ;;
  "ssm put-parameter")
    input=$(opt --cli-input-json "$@")
    jq -c . "${input#file://}" >>"${state}/put-requests.jsonl"
    echo '{"Version":1,"Tier":"Standard"}' ;;

  *)
    echo "mock aws: unsupported call: ${svc} ${op}" >&2
    exit 255 ;;
esac
